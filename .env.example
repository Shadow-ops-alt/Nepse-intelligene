# Runtime policy
# Unofficial sources are blocked unless this is explicitly true.
# This flag is ignored in licensed production.
ALLOW_UNOFFICIAL_DATA=false
NODE_ENV=development

# Product edition: "free" runs the shipped Free Edition on unofficial data.
# "licensed" (default) is the strict edition and blocks unofficial data.
DATA_EDITION=free

# Manual/licensed data fallback
MANUAL_DATA_DIR=./data/manual
# Set true only after the data licence has been reviewed and attested.
MANUAL_DATA_LICENSED=false

# Personal research mode (free/unofficial data, single user, not for production)
# Requires ALLOW_UNOFFICIAL_DATA=true. Never used when NODE_ENV=production.
PERSONAL_DATA_DIR=./data/personal
PERSONAL_DB=./data/personal.db
# Optional comma-separated capability override. Defaults to the free-source set.
PERSONAL_CAPABILITIES=

# Licensed REST provider (fill only after a contract exists)
LICENSED_BASE_URL=
LICENSED_API_KEY=
LICENSED_ATTESTED=false
LICENSED_TERMS_URL=
LICENSED_LICENSE=

# Generic external command provider (development/validation only)
# The command must follow the JSON contract in docs/ARCHITECTURE.md.
COMMAND_PROVIDER_CMD=
COMMAND_PROVIDER_ID=external-command
COMMAND_PROVIDER_NAME=External command provider
COMMAND_PROVIDER_TIMEOUT_MS=60000
COMMAND_PROVIDER_SOURCE_TYPE=unofficial
COMMAND_PROVIDER_TERMS_STATUS=unverified
# Comma-separated list; omit to declare all capabilities.
COMMAND_PROVIDER_CAPABILITIES=
