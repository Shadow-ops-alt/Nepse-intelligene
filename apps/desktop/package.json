{
  "name": "@stock/desktop",
  "productName": "NEPSE Terminal",
  "desktopName": "nepse-terminal.desktop",
  "version": "0.5.0",
  "private": true,
  "description": "NEPSE Terminal desktop shell (Free Edition)",
  "author": "NEPSE Terminal",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "electron:server": "esbuild electron/server.ts --bundle --platform=node --format=esm --outfile=electron/server.mjs --external:electron --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\" && node -e \"const fs=require('node:fs');fs.copyFileSync(require.resolve('nepseman-api/dist/nepse.wasm',{paths:[fs.realpathSync('node_modules/@stock/api')]}),'electron/nepse.wasm')\"",
    "electron:start": "install-electron && pnpm build && pnpm electron:server && electron .",
    "electron:dev": "NEPSE_DEV_URL=http://127.0.0.1:5173 electron .",
    "electron:package": "pnpm build && pnpm electron:server && electron-builder"
  },
  "devDependencies": {
    "@stock/analytics": "workspace:*",
    "@stock/api": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.nepse.terminal",
    "productName": "NEPSE Terminal",
    "executableName": "nepse-terminal",
    "asar": false,
    "files": [
      "dist/**/*",
      "electron/main.mjs",
      "electron/server.mjs",
      "electron/nepse.wasm",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/personal.db.gz",
        "to": "starter/personal.db.gz"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "NEPSE-Terminal-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEPSE Terminal",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    }
  }
}
